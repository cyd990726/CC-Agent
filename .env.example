# Required: any OpenAI-compatible chat completions provider.
MINI_AGENT_MODEL="your-model"
MINI_AGENT_API_KEY="your-api-key"
MINI_AGENT_BASE_URL="https://api.openai.com/v1"

# Optional runtime limits.
MINI_AGENT_MAX_STEPS="20"
# MINI_AGENT_MAX_RPM="3"

